# apps/web/.env.local 로 복사해서 채운다. .env.local 은 커밋하지 않는다.
# 웹(apps/web)과 워커(apps/worker)가 이 파일 하나를 같이 읽는다 —
# RIOT_API_KEY 를 두 군데 두면 반드시 한쪽이 만료된 채로 남는다.

# ── DB ───────────────────────────────────────────────────────────────
# Supabase → Connect → URI 를 **그대로 복사**한다 (풀러 호스트의 aws-N 숫자는 프로젝트마다 다르다).
#   직결   :5432  IPv6 전용. WSL 등에서 안 나갈 수 있다
#   풀러   :6543  IPv4. prepare 가 꺼져 있어야 하는데 코드에서 이미 꺼 뒀다
DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres

# 로컬 PGlite(`npm run dev:db`)를 쓸 때만. 소켓 서버가 동시 연결을 못 받는다.
# DATABASE_POOL_MAX=1

# ── Riot ─────────────────────────────────────────────────────────────
# developer.riotgames.com 에서 발급.
# ★ Development 키는 24시간마다 만료된다. 매일 갈아끼워야 한다.
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── NEXON FC온라인 ───────────────────────────────────────────────────
# https://openapi.nexon.com → 내 애플리케이션에서 발급. 이 값도 커밋하지 않는다.
NEXON_API_KEY=

# ── 관리자 ───────────────────────────────────────────────────────────
# ★ ADMIN_PASSWORD 가 비면 /admin 은 503 으로 잠긴다 (fail-closed).
ADMIN_USER=admin
ADMIN_PASSWORD=

# ── 회원 로그인(소셜) — docs/COMMUNITY-PLAN.md §2 ─────────────────────
# client id 가 없는 제공자는 로그인 버튼을 그리지 않는다(fail-closed). 둘 다 비면 로그인 자체가 없다.
# 제공자에 등록할 redirect_uri = SITE_ORIGIN + /auth/<kakao|google>/callback
# ★ 운영은 SITE_ORIGIN 필수 — 프록시 뒤에서 요청 주소로 만들면 redirect_uri 가 어긋나 로그인이 실패한다.
#   로컬은 비우면 요청 주소(http://localhost:3000)를 쓴다.
# SITE_ORIGIN=https://example.com
# KAKAO_CLIENT_ID=            # REST API 키. [카카오 로그인] 사용 설정 ON → [OpenID Connect] ON
# KAKAO_CLIENT_SECRET=        # 보안 → Client Secret 을 켰을 때만
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# CK 판독 검수(/admin/ck)가 프레임 이미지를 읽을 디렉터리. **절대 경로**.
# ★ 비우면 그 화면의 이미지가 503 이 된다(다른 기능은 멀쩡하다).
#   cwd 에서 거슬러 올라가 찾던 판을 없앤 이유: 빌드가 그 상향 경로를 추적해
#   out/(3.2GB)을 배포 산출물에 통째로 복사했다. 실측 3.3GB → 67MB.
CK_OUT_ROOT=/절대/경로/soop-lol/out

# ── 워커 (전부 선택. 기본값은 docs/SETUP.md §6) ──────────────────────
# RANK_HOUR_KST=9
# LIVE_INTERVAL_MINUTES=10
# BACKFILL_BATCH=25
# WORKER_VERBOSE=false
