# apps/web/.env.local 로 복사해서 채운다. .env.local 은 커밋하지 않는다.
# 웹(apps/web)과 워커(apps/worker)가 이 파일 하나를 같이 읽는다 —
# RIOT_API_KEY 를 두 군데 두면 반드시 한쪽이 만료된 채로 남는다.

# ── DB ───────────────────────────────────────────────────────────────
# Supabase → Connect → URI 를 **그대로 복사**한다 (풀러 호스트의 aws-N 숫자는 프로젝트마다 다르다).
#   직결   :5432  IPv6 전용. WSL 등에서 안 나갈 수 있다
#   풀러   :6543  IPv4. prepare 가 꺼져 있어야 하는데 코드에서 이미 꺼 뒀다
DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres

# 로컬 PGlite(`npm run dev:db`)를 쓸 때만. 소켓 서버가 동시 연결을 못 받는다.
# DATABASE_POOL_MAX=1

# ── Riot ─────────────────────────────────────────────────────────────
# developer.riotgames.com 에서 발급.
# ★ Development 키는 24시간마다 만료된다. 매일 갈아끼워야 한다.
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── 관리자 ───────────────────────────────────────────────────────────
# ★ ADMIN_PASSWORD 가 비면 /admin 은 503 으로 잠긴다 (fail-closed).
ADMIN_USER=admin
ADMIN_PASSWORD=

# ── 워커 (전부 선택. 기본값은 docs/SETUP.md §6) ──────────────────────
# RANK_HOUR_KST=9
# LIVE_INTERVAL_MINUTES=10
# BACKFILL_BATCH=25
# WORKER_VERBOSE=false
