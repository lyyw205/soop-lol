# 랭크 스냅샷 (Engine A) — soop-rank.timer 가 부른다. 설치: scripts/systemd/install.sh
# ★ 같은 출처(API·홈페이지)를 쓰는 작업은 같은 잠금(riot)을 잡아 겹치지 않는다 — 레이트리밋 버킷이 프로세스마다 따로라
#   동시에 돌면 각자 한도 안이라 믿으며 합쳐서 넘긴다(CLAUDE.md 워커). 앞 작업이 돌면 최대 30분 기다린다(제한 시간은 기다림+실행 기준).
# ★ 로컬(WSL)에서는 상주 워커(worker -- loop)를 띄우지 않는다 — loop 가 이 작업들을 안에서 또 돌린다.
[Unit]
Description=soop-lol 랭크 스냅샷 (Engine A)
# 실패(키 오류·일부 계정 실패 = 종료 코드 3)면 20분 뒤 다시 돈다. 같은 날짜로 덮어쓰므로 다시 돌려도 안전하다.
# 6시간 안에 3번까지 — 그 뒤엔 실패로 남아 --status 에 보인다.
StartLimitIntervalSec=6h
StartLimitBurst=3

[Service]
Type=oneshot
WorkingDirectory=%h/repos/soop-lol
Environment=PATH=%h/.local/node/bin:/usr/local/bin:/usr/bin:/bin
ExecStartPre=/usr/bin/mkdir -p %h/repos/soop-lol/out/locks
ExecStart=/usr/bin/flock -w 1800 %h/repos/soop-lol/out/locks/riot.lock npm run -s worker -- rank
TimeoutStartSec=80min
Nice=10
Restart=on-failure
RestartSec=20min
