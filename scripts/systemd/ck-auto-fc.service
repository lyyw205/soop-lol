[Unit]
Description=soop-lol 매일 FC API 경기 맥락 조사

[Service]
Type=oneshot
WorkingDirectory=%h/repos/soop-lol
# 감싸는 실행기(scripts/ops/run-job.ts)가 실행 하나를 job_run 한 행으로 남긴다 — 원래 명령·종료 코드는 그대로(ops/jobs/ck-auto-fc.json).
ExecStart=%h/.local/node/bin/node %h/repos/soop-lol/scripts/ops/run-job.ts --job ck-auto-fc -- %h/repos/soop-lol/scripts/ck-auto.sh --fc
TimeoutStartSec=6h
KillMode=control-group
Nice=10
IOSchedulingClass=idle
