[Unit]
Description=soop-lol 대기 VOD 조사 (롤 작업자 3개)

[Service]
Type=oneshot
WorkingDirectory=%h/repos/soop-lol
# 감싸는 실행기(scripts/ops/run-job.ts)가 실행 하나를 job_run 한 행으로 남긴다 — 원래 명령·종료 코드는 그대로(ops/jobs/ck-auto-lol-work.json).
ExecStart=%h/.local/node/bin/node %h/repos/soop-lol/scripts/ops/run-job.ts --job ck-auto-lol-work -- %h/repos/soop-lol/scripts/ck-auto.sh --work
# 300분 뒤 새 작업을 멈추고, 진행 중 세션이 저장할 여유를 준다.
TimeoutStartSec=6h
KillMode=control-group
Nice=10
IOSchedulingClass=idle
