{
  "id": "fco-rating",
  "title": "FC 공식경기 티어",
  "group": "collect",
  "install": "default",
  "units": [
    "scripts/systemd/soop-fco-rating.service",
    "scripts/systemd/soop-fco-rating.timer"
  ],
  "run": "npm run -s worker -- fco-rating",
  "schedule": "2시간마다(홀수 시) :40",
  "record": "runner",
  "office": {
    "room": "fc",
    "cadence": "2시간마다",
    "max_age_min": 180,
    "max_run_min": 40
  },
  "locks": [
    "out/locks/fc-site.lock"
  ],
  "resources": [
    "fc-site"
  ],
  "job_run_names": [
    "engine_h_fco_rating"
  ],
  "docs": [
    "docs/SETUP.md"
  ],
  "notes": "지나간 시점의 티어는 못 구한다.",
  "remove": [
    "설치돼 있으면 먼저 scripts/systemd/install.sh --disable-job fco-rating",
    "apps/worker/src/main.ts 의 명령과 운영 화면 대사(apps/web/components/admin/office/dialogue.ts)에 이름이 있으면 그 줄",
    "units 파일들과 이 파일을 지운다",
    "node scripts/ops/jobs.ts sync 로 운영 화면 목록을 다시 만들고 npm run verify:automation"
  ]
}
